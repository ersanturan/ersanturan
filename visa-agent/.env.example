# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env repoya gönderilmez.

# VFS Global hesabınız (https://visa.vfsglobal.com/tur/tr/fra/login)
VFS_EMAIL=
VFS_PASSWORD=

# Uygun randevu bildirimi gidecek adres(ler); birden fazlaysa virgülle ayırın
NOTIFY_TO=

# E-posta gönderimi (Gmail): SMTP_USER gönderen Gmail adresi,
# SMTP_PASS bu hesap için oluşturulan 16 haneli "Uygulama şifresi" (normal şifre çalışmaz)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# İsteğe bağlı: agent takılırsa (captcha, OTP, engelleme) uyarının gideceği adres.
# Boş bırakılırsa SMTP_USER adresine gider.
ERROR_NOTIFY_TO=

# Gmail yerine SendGrid kullanmak isterseniz (SMTP_USER boşken kullanılır):
# SENDGRID_API_KEY=
# SENDGRID_FROM=
